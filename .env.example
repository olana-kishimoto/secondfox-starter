# NEXT_PUBLIC_ で始まるものは「ブラウザに配られる公開値」。秘密は絶対に NEXT_PUBLIC_ に置かない。
# システム名（ホーム画面に追加したときの名前）。公開値。SecondFox が新規作成時にお客様のシステム名で埋める。未設定なら src/lib/app-info.ts の名前。
NEXT_PUBLIC_APP_NAME=

# Supabase の3つは SecondFox が新規作成時に自動で埋める。

# 公開値。
NEXT_PUBLIC_SUPABASE_URL=
# 公開値。RLS が守るので、ログインしていなければ何も読み書きできない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用の秘密（RLS を越える鍵）。ブラウザ・ログ・画面に出さない。通常の画面では使わない。
SUPABASE_SERVICE_ROLE_KEY=

# 入口の合言葉（どちらもサーバー専用の秘密）。未設定のままだと誰も入口を通れない（安全側に止まる）。
# 32桁の合言葉。カンマ区切りで複数可（32桁以外は無視される）。
ACCESS_KEYS=
# Cookie の署名鍵。長いランダム値（例：openssl rand -hex 32）。未設定だと誰も入口を通れない。
ACCESS_COOKIE_SECRET=

# ローカル開発だけで使う（入口を外す）。本番では設定しない。
# ACCESS_ENABLED=false
