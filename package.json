{
  "name": "secondfox-starter",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:boundary && npm run test:perm && npm run test:ip-gate && npm run test:middleware-gate && npm run test:noserverfnprops && npm run test:caseform-state && npm run test:master-crud",
    "check:boundary": "node scripts/check-boundary.mjs",
    "test:perm": "node --experimental-strip-types --no-warnings scripts/test-perm.mjs",
    "test:ip-gate": "node --experimental-strip-types --no-warnings scripts/test-ip-gate.mjs",
    "test:middleware-gate": "node --no-warnings scripts/test-middleware-gate.mjs",
    "test:noserverfnprops": "node --no-warnings scripts/test-noserverfnprops.mjs",
    "test:caseform-state": "node --no-warnings scripts/test-caseform-state.mjs",
    "test:master-crud": "node --no-warnings scripts/test-master-crud.mjs",
    "seed:demo": "psql \"$DATABASE_URL\" -f supabase/seed/demo.sql"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
